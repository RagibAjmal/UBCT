{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: UBCT",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\manage.py",
            "args": [
                "runserver",
                "--noreload",
                "127.0.0.1:8000"
            ],
            "django": true,
            "envFile": "${workspaceFolder}\\.env",
            "console": "integratedTerminal"
        }
    ]
}
